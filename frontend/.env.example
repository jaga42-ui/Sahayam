# Backend API base URL. MUST include the /api suffix — the app reads this exact name.
VITE_BACKEND_URL=http://localhost:5000/api

# Google OAuth client ID (for "Sign in with Google")
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Web Push public key (must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Optional: Mapbox token, used only to show your city name on the radar.
# The map works without it (tiles come from OpenStreetMap).
VITE_MAPBOX_TOKEN=your_mapbox_token
